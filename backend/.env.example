PORT=5000
NODE_ENV=development

# Optional: Set your OpenAI API key for direct Whisper transcription on backend
# If not provided, the frontend will automatically use browser Web Speech API with fallback NLP extractor!
OPENAI_API_KEY=your_openai_api_key_here

# Database URL (For MongoDB / PostgreSQL production deployment)
DATABASE_URL=mongodb://localhost:27017/ai-finance-controller
JWT_SECRET=super_secret_jwt_key_for_finance_auth
